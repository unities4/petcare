# Скопируйте в .env.local и подставьте значения из Supabase → Settings → API.
# Оба значения публичные: anon-ключ уезжает в браузер каждого пользователя,
# доступ ограничивает RLS. Ключ service_role сюда не кладут никогда.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
